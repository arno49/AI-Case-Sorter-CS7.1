{
	"name": "@cs71/appliance-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "npm@10.9.8",
	"engines": {
		"node": ">=22.12.0",
		"npm": ">=10.9.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:api": "openapi-typescript ../contracts/cs71d-v1.openapi.json --output src/lib/api/cs71d-v1.d.ts --immutable",
		"check:api": "openapi-typescript ../contracts/cs71d-v1.openapi.json --output src/lib/api/cs71d-v1.d.ts --immutable --check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"report:dependencies": "node scripts/dependency-report.mjs",
		"bootstrap-token": "tsx scripts/issue-bootstrap-token.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22",
		"axe-core": "^4.13.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"better-sqlite3": "^13.0.3",
		"tsx": "^4.23.12"
	}
}
