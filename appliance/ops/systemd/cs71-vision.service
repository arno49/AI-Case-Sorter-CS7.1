[Unit]
Description=cs71-vision - camera capture for the CS7.1 appliance
Documentation=https://github.com/arno49/AI-Case-Sorter-CS7.1/blob/main/appliance/vision/README.md
After=local-fs.target dev-cs71vision.device
BindsTo=dev-cs71vision.device
ConditionPathExists=/dev/cs71vision
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cs71-vision
# The effective group, not a supplementary one - the same shape cs71d.service
# itself uses. cs71-vision needs cs71-api both ways: to reach cs71d's socket
# as a client, and so PI-VISION-003's own dataset socket (below) comes out
# owned cs71-vision:cs71-api, reachable by cs71-web the same way cs71d's is.
# Real OS-level membership in cs71-api (for su/runuser outside systemd) is
# still granted separately in install.sh.
Group=cs71-api
UMask=0077
ExecStart=/opt/cs71/vision/venv/bin/cs71vision --serve /etc/cs71/cs71vision.toml
Restart=on-failure
RestartSec=2

# Only the matched camera symlink, only read/write, nothing else in /dev -
# the same discipline cs71d.service's DeviceAllow= already uses for the
# serial adapter.
DeviceAllow=/dev/cs71vision rw

# PI-VISION-003's own dataset API socket. Recreated fresh on every start,
# owned cs71-vision:cs71-api the same way /run/cs71 is cs71d:cs71-api; the
# socket file itself gets its own 0660 mode in code (cs71vision.api), not
# here - group access is how cs71-web reaches it without any other grant.
RuntimeDirectory=cs71-vision
RuntimeDirectoryMode=0750

# PI-VISION-002's self-labeled dataset (vision.db) lives here; cs71-vision
# exclusively owns it, the same separate-ownership rule machine.db/web.db
# already follow.
StateDirectory=cs71-vision
StateDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX only, to reach cs71d - the same restriction cs71d.service itself
# carries. No AF_INET/AF_INET6: this service has no loopback port of its own
# to bind, unlike cs71-web.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=512M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
